{% comment %} Have questions help section {% endcomment %}
<table class="row on-help" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="section__cell" style="background-color: #F3EDE1; padding: 32px 0 0;">
      <center>
        <table class="container" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="center" style="padding: 0;">
              <img src="{{ on_have_questions_headline_url }}" alt="Have questions?" width="600" height="47" class="on-subheadline-img" style="display: block; width: 100%; max-width: 600px; height: auto; border: 0;">
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 12px 24px 40px;">
              <p style="font-family: 'SharpSans-Book', Poppins, sans-serif; color: #960000; font-size: 15px; line-height: 1.6; margin: 0; text-align: center;">We're here to help. <a href="{{ on_contact_url }}" style="color: #960000; text-decoration: underline;">Contact us</a> or check out our <a href="{{ on_faqs_url }}" style="color: #960000; text-decoration: underline;">FAQs</a>.</p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

{% comment %} Made for Pets module {% endcomment %}
<table class="row on-made-for-pets" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="background-color: #FFB000; padding: 0;">
      <table class="container" width="100%" cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="padding: 0;">
            <img src="{{ on_made_for_pets_headline_url }}" alt="Made For Pets And The People Who Effing Love Them." width="600" height="79" class="on-subheadline-img" style="display: block; width: 100%; max-width: 600px; height: auto; border: 0;">
          </td>
        </tr>
        <tr>
          <td align="center" style="padding: 16px 24px 40px;">
            <p class="on-made-for-pets-body">All-natural supplements, treats &amp; care products in partnership with Board-Certified Veterinary Specialists. Plus, every purchase <a href="{{ on_rescue_url }}" style="color: #960000; text-decoration: underline;">gives back to rescues</a>.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% comment %} Shop navigation {% endcomment %}
<table class="row on-nav" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="background-color: #960000; padding: 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="padding: 20px 24px; border-bottom: 1px solid #FAF4E8;">
            <a href="{{ on_dog_url }}" class="on-nav-link">Dog</a>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding: 20px 24px; border-bottom: 1px solid #FAF4E8;">
            <a href="{{ on_cat_url }}" class="on-nav-link">Cat</a>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding: 20px 24px; border-bottom: 1px solid #FAF4E8;">
            <a href="{{ on_gift_url }}" class="on-nav-link">Gift Card</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% comment %} Branded footer {% endcomment %}
<table class="row footer on-footer" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="footer__cell" style="background-color: #960000; padding: 28px 20px 32px; border: none !important; border-top: none !important; outline: none;">
