{% assign delivery_method_types = delivery_agreements | map: 'delivery_method_type' | uniq %}
{% assign has_split_cart = false %}
{% assign non_none_count = 0 %}
{% for type in delivery_method_types %}
  {% unless type == 'none' %}
    {% assign non_none_count = non_none_count | plus: 1 %}
  {% endunless %}
{% endfor %}
{% if non_none_count > 1 %}
  {% assign has_split_cart = true %}
{% endif %}

{% assign non_none_agreements_count = 0 %}
{% for agreement in delivery_agreements %}
  {% unless agreement.delivery_method_type == 'none' %}
    {% assign non_none_agreements_count = non_none_agreements_count | plus: 1 %}
  {% endunless %}
{% endfor %}

{% comment %} Oh Norman! email UTM tracking {% endcomment %}
{% assign on_utm_base = 'utm_source=shopify_email&utm_medium=email&utm_campaign=order_confirmation' %}
{% assign on_logo_url = 'https://cdn.shopify.com/s/files/1/0790/2049/1041/files/ohnorman-logo-light.webp?v=1787677671' %}
{% capture on_shop_url %}{{ shop.url }}?{{ on_utm_base }}&utm_content=shop{% endcapture %}
{% capture on_contact_url %}https://ohnorman.com/pages/contact?{{ on_utm_base }}&utm_content=contact{% endcapture %}
{% capture on_faqs_url %}https://ohnorman.com/pages/faqs-1?{{ on_utm_base }}&utm_content=faqs{% endcapture %}
{% capture on_dog_url %}https://ohnorman.com/collections/our-dog-products?{{ on_utm_base }}&utm_content=dog{% endcapture %}
{% capture on_cat_url %}https://ohnorman.com/collections/our-cat-products?{{ on_utm_base }}&utm_content=cat{% endcapture %}
{% capture on_gift_url %}https://ohnorman.com/collections/gift-cards?{{ on_utm_base }}&utm_content=gift_card{% endcapture %}
{% capture on_rescue_url %}https://ohnorman.com/pages/about-us-1?{{ on_utm_base }}&utm_content=gives_back{% endcapture %}
{% capture on_privacy_url %}https://ohnorman.com/policies/privacy-policy?{{ on_utm_base }}&utm_content=privacy{% endcapture %}
{% capture on_terms_url %}https://ohnorman.com/policies/terms-of-service?{{ on_utm_base }}&utm_content=terms{% endcapture %}
{% capture on_facebook_url %}https://www.facebook.com/ohnorman/?{{ on_utm_base }}&utm_content=facebook{% endcapture %}
{% capture on_instagram_url %}https://www.instagram.com/ohnorman/?{{ on_utm_base }}&utm_content=instagram{% endcapture %}
{% capture on_tiktok_url %}https://www.tiktok.com/@oh_norman_?{{ on_utm_base }}&utm_content=tiktok{% endcapture %}
{% assign on_made_for_pets_headline_url = 'https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Made_for_transactional_email_header.png?v=1787678918' %}
{% assign on_have_questions_headline_url = 'https://cdn.shopify.com/s/files/1/0790/2049/1041/files/Have_questions.png?v=1787678909' %}
{% assign on_facebook_icon_url = 'https://cdn.shopify.com/s/files/1/0790/2049/1041/files/FFB100.png?v=1787678882' %}
{% assign on_tiktok_icon_url = 'https://cdn.shopify.com/s/files/1/0790/2049/1041/files/tiktok-yellow.png' %}
{% assign on_instagram_icon_url = 'https://cdn.shopify.com/s/files/1/0790/2049/1041/files/FFB100_2.png?v=1787678881' %}
{% if order_status_url != blank %}
  {% if order_status_url contains '?' %}
    {% capture on_order_status_url %}{{ order_status_url }}&{{ on_utm_base }}&utm_content=view_order{% endcapture %}
  {% else %}
    {% capture on_order_status_url %}{{ order_status_url }}?{{ on_utm_base }}&utm_content=view_order{% endcapture %}
  {% endif %}
{% endif %}
{% if shop_app_tracking_url != blank %}
  {% if shop_app_tracking_url contains '?' %}
    {% capture on_shop_app_url %}{{ shop_app_tracking_url }}&{{ on_utm_base }}&utm_content=shop_app{% endcapture %}
  {% else %}
    {% capture on_shop_app_url %}{{ shop_app_tracking_url }}?{{ on_utm_base }}&utm_content=shop_app{% endcapture %}
  {% endif %}
{% endif %}

{% capture email_title %}Thank you for your order, {{ customer.first_name }}!{% endcapture %}
{% capture email_body %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      You’ll get a confirmation email after completing your payment.
    {% else %}
      Your payment is being processed. You'll get an email when your order is confirmed.
    {% endif %}
  {% elsif payment_charged_on_fulfillment %}
    Hi {{ customer.first_name }}, we received your order. Your payment method will be charged when your order is ready to be fulfilled. We'll notify you when it's on its way.
  {% else %}
    Your order is being prepared. We'll send you another email as soon as it's on the way.
  {% endif %}
  {% assign gift_card_line_items = line_items | where: "gift_card" %}
  {% assign found_gift_card_with_recipient_email = false %}
  {% for line_item in gift_card_line_items %}
    {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
      {% assign found_gift_card_with_recipient_email = true %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if found_gift_card_with_recipient_email %}
    <p>Your gift card recipient will receive an email with their gift card code.</p>
  {% elsif gift_card_line_items.first %}
    <p>You’ll receive separate emails for any gift cards.</p>
  {% endif %}
{% endcapture %}

